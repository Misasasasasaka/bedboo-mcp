# The exact Bedrock Dedicated Server version and transport.
MC_HOST=127.0.0.1
MC_PORT=19132
MC_VERSION=1.26.63.1
MC_TRANSPORT=nethernet
# Use the Microsoft account assigned to the Minecraft player.
MC_AUTH=microsoft
MC_ACCOUNT=bot@example.com
# Set MCP_TRANSPORT=http for a persistent endpoint at http://127.0.0.1:3107/mcp
MCP_TRANSPORT=stdio
MCP_PORT=3107
# MCP_HTTP_TOKEN=your-private-token
# MC_DATA_DIR=.bedboo-mcp
# MC_COMMAND_TIMEOUT_MS=8000
# MC_MOVE_TIMEOUT_MS=45000
