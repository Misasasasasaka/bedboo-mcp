# The exact Bedrock Dedicated Server version and transport.
MC_HOST=127.0.0.1
MC_PORT=19132
MC_VERSION=1.26.63.1
MC_TRANSPORT=nethernet
# Use the Microsoft account assigned to the Minecraft player.
MC_AUTH=microsoft
MC_ACCOUNT=bot@example.com

# Configure a tool-calling model to start the embedded agent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.example.com/v1
# OPENAI_API_MODE=responses
# AGENT_COMMANDERS=YourMinecraftGamertag
# AGENT_GOAL="查看我游戏里的位置和附近方块"
# AGENT_MAX_ROUNDS=24

# Optional external MCP transport. Defaults to off with an API key and stdio otherwise.
# MCP_TRANSPORT=http
MCP_PORT=3107
# MCP_HTTP_TOKEN=your-private-token
# MC_DATA_DIR=.bedboo-mcp
# MC_COMMAND_TIMEOUT_MS=8000
# MC_MOVE_TIMEOUT_MS=45000
